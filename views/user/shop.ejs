<%- include("../../views/partials/user/header") %>

<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<style>
 .swal2-popup {
    background: #fff0f5;  /* Light lavender */
    color: #333;
    font-family: 'Arial, sans-serif';
}

.custom-swal-perfume-icon {
    font-size: 30px !important;  /* Smaller icon size */
    color: #ff69b4;              /* Pinkish */
}

.main-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px;
    padding-top: 80px;
}

.shop-page {
    width: 100%;
}

.shop-topbar {
    display: flex !important;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    min-height: 50px !important;
    width: 100% !important;
    position: relative;
    z-index: 10;
    background-color: #fff;
    padding: 10px;
    overflow: visible !important;
}

.search-bar {
    flex: 1;
    max-width: 400px;
}

.search-form {
    display: flex !important;
    align-items: center;
    background-color: #f1f1f1;
    border-radius: 25px;
    overflow: visible !important;
    max-width: 400px;
    box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
    width: 100%;
}

.search-input {
    flex: 1;
    padding: 10px 15px;
    font-size: 14px;
    border: none;
    outline: none;
    background-color: transparent;
}

.search-button,
.clear-button {
    padding: 10px 20px;
    color: #fff;
    border: none;
    cursor: pointer;
    font-size: 14px;
    border-radius: 15px;
    margin-right: 5px;
    transition: background-color 0.3s, transform 0.2s;
}

.search-button {
    background-color: #000;
}

.clear-button {
    background-color: #dc3545;
}

.search-button:hover {
    background-color: #333;
    transform: scale(1.05);
}

.clear-button:hover {
    background-color: #c82333;
    transform: scale(1.05);
}

.sort-container {
    display: flex !important;
    align-items: center;
}

.sort-container select {
    padding: 8px;
    font-size: 14px;
    border-radius: 5px;
    border: 1px solid #ddd;
}

.sidebar {
    padding: 20px;
    border: 1px solid #ddd;
    background-color: #f9f9f9;
    border-radius: 8px;
    margin-bottom: 20px;
    width: 250px;
    text-align: left;
    transition: transform 0.3s ease-in-out;
}

.filter-section {
    margin-bottom: 20px;
}

.filter-title {
    font-weight: bold;
    margin-bottom: 10px;
    font-size: 16px;
    color: #333;
    text-transform: uppercase;
}

.filter-item {
    margin: 5px 0;
}

.filter-item label {
    display: flex;
    align-items: center;
    color: #333;
    cursor: pointer;
}

.filter-item input[type="checkbox"] {
    margin-right: 5px;
}

.product-list-container {
    display: flex;
    gap: 20px;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 20px;
    width: calc(100% - 270px);
}

.product-card {
    border: 1px solid #e0e0e0;
    padding: 15px;
    border-radius: 10px;
    text-align: center;
    background-color: #fff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    transition: transform 0.2s;
    position: relative;
    height: auto;
}

.product-card:hover {
    transform: translateY(-5px);
}

.product-card img {
    max-width: 100%;
    height: auto;
    border-radius: 5px;
    margin-bottom: 10px;
}

.product-card h4 {
    font-size: 16px;
    margin: 10px 0;
    color: #333;
}

.product-meta {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 5px;
}

.category-name,
.brand-name {
    font-size: 12px;
    color: #666;
    font-weight: normal;
}

.category-name::after {
    content: ' | ';
    color: #999;
}

.brand-name::after {
    content: '';
}

.product-card p {
    font-size: 14px;
    color: #dc3545;
    font-weight: bold;
    margin: 5px 0;
}

.product-card .original-price {
    color: #999;
    font-size: 12px;
    text-decoration: line-through;
    margin-left: 5px;
}

.wishlist-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    cursor: pointer;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.wishlist-btn svg {
    width: 20px;
    height: 20px;
    stroke: black;
    fill: none;
    transition: fill 0.3s, stroke 0.3s;
}

.wishlist-btn.active svg {
    fill: #dc2626;
    stroke: #dc2626;
}

.wishlist-btn:hover svg {
    stroke: #ff4444;
}

.button-add-to-cart {
    background: linear-gradient(to right, #f97316, #ef4444);
    color: #fff;
    padding: 10px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    width: 100%;
    margin-top: 10px;
    font-size: 14px;
    transition: background 0.3s, transform 0.2s;
}

.button-add-to-cart:hover {
    background: linear-gradient(to right, #f97316, #ef4444);
    transform: scale(1.05);
}

.button-add-to-cart.active {
    background: linear-gradient(to right, #f97316, #ef4444);
}

.pagination {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin: 20px 0;
}

.pagination a {
    padding: 8px 12px;
    background-color: #f0f0f0;
    border: 1px solid #ddd;
    color: #333;
    text-decoration: none;
    border-radius: 5px;
}

.pagination .active {
    background-color: orange;
    color: #fff;
}

.price-filter {
    padding: 10px;
    background-color: #f9f9f9;
    border-radius: 8px;
    margin-top: 20px;
}

.price-options {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.price-button {
    padding: 12px 20px;
    background-color: #f1f1f1;
    color: #333;
    border: 1px solid #ddd;
    border-radius: 30px;
    cursor: pointer;
    transition: background-color 0.3s, transform 0.2s;
    text-align: center;
    font-size: 14px;
}

.price-button:hover {
    background-color: #007bff;
    color: white;
    transform: scale(1.05);
}

.price-button:active {
    transform: scale(0.95);
}

/* Mobile Responsiveness */
@media (max-width: 768px) {
    .product-list-container {
        flex-direction: column;
    }

    .product-grid {
        grid-template-columns: 1fr;
        width: 100%;
    }

    .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        height: 100%;
        width: 250px;
        transform: translateX(-100%);
        z-index: 1000;
        background-color: #fff;
        box-shadow: 2px 0 5px rgba(0, 0, 0, 0.2);
        display: none; /* Ensure sidebar is hidden by default */
    }

    .sidebar.active {
        display: block; /* Show when active */
        transform: translateX(0);
    }

    .shop-topbar {
        flex-wrap: wrap;
        gap: 10px;
    }

    .search-bar {
        max-width: 100%;
    }

    .search-form {
        max-width: 100%;
    }

    .filter-toggle-btn {
        display: block;
        padding: 10px;
        background-color: #007bff;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 16px;
    }

    .filter-toggle-btn:hover {
        background-color: #0056b3;
    }

    /* Overlay for sidebar */
    .overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 999;
    }

    .overlay.active {
        display: block;
    }
}
</style>

<div class="main-container">
  <section class="shop-page container">
    <div class="shop-topbar flex flex-col md:flex-row md:items-center md:justify-between gap-4 md:gap-2 p-4">
  
  <!-- Filters & Clear -->
  <div class="flex flex-row gap-2 md:gap-4">
    <button class="filter-toggle-btn flex items-center gap-1 px-4 py-2 bg-gray-100 rounded hover:bg-gray-200" onclick="toggleSidebar()">
      <i class="fas fa-filter"></i> Filters
    </button>
    <a href="/shop">
      <button type="button" class="clear-button px-4 py-2 bg-gray-100 rounded hover:bg-gray-200">Clear Filter</button>
    </a>
  </div>

  <!-- Search Bar -->
  <div class="search-bar w-full md:w-auto">
    <form action="/shop" method="POST" class="search-form d-inline w-full">
      <div class="flex justify-center w-full">
        <div class="relative w-full max-w-md">
          <input
            type="text"
            name="query"
            placeholder="Search..."
            class="w-full border border-gray-200 rounded-full py-3 px-6 text-gray-600 focus:outline-none focus:ring-2 focus:ring-amber-500 bg-gray-50"
            value="<%= searchQuery || '' %>"
          />
          
          <% categoryId.forEach(id => { %>
            <input type="hidden" name="category" value="<%= id %>">
          <% }) %>
          <% brandId.forEach(id => { %>
            <input type="hidden" name="brand" value="<%= id %>">
          <% }) %>
          <input type="hidden" name="sort" value="<%= sort || 'default' %>">
          <input type="hidden" name="price" value="<%= priceRange || '' %>">
          
          <button 
            type="submit"
            class="absolute right-2 top-1/2 transform -translate-y-1/2 bg-gradient-to-r from-amber-500 to-orange-500 text-white px-4 py-2 rounded-full hover:from-amber-600 hover:to-orange-600 transition duration-300 transform hover:scale-105"
          >
            Search
          </button>
        </div>
      </div>
    </form>
  </div>

  <!-- Sort Dropdown -->
  <div class="sort-container w-full md:w-auto">
    <select onchange="updateSort(this.value)" class="w-full md:w-auto border border-gray-200 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white">
      <option value="default" <%= sort === 'default' ? 'selected' : '' %>>Default</option>
      <option value="priceLowToHigh" <%= sort === 'priceLowToHigh' ? 'selected' : '' %>>Price: Low to High</option>
      <option value="priceHighToLow" <%= sort === 'priceHighToLow' ? 'selected' : '' %>>Price: High to Low</option>
      <option value="nameAsc" <%= sort === 'nameAsc' ? 'selected' : '' %>>A - Z</option>
      <option value="nameDesc" <%= sort === 'nameDesc' ? 'selected' : '' %>>Z - A</option>
    </select>
  </div>
</div>


    <div class="overlay" onclick="toggleSidebar()"></div>

    <div class="product-list-container">
      <aside class="sidebar">
        <div class="filter-section">
          <div class="filter-title">Categories</div>
          <div class="category-brand-container">
            <ul>
              <% categories.forEach(category => { %>
                <li class="filter-item">
                  <label>
                    <input
                      type="checkbox"
                      name="category"
                      value="<%= category._id %>"
                      <%= categoryId.includes(category._id.toString()) ? 'checked' : '' %>
                      onchange="updateFilters()"
                    />
                    <%= category.name %>
                  </label>
                </li>
              <% }) %>
            </ul>
          </div>
        </div>

        <div class="filter-section">
          <div class="filter-title">Brands</div>
          <div class="category-brand-container">
            <ul>
              <% brands.forEach(brand => { %>
                <li class="filter-item">
                  <label>
                    <input
                      type="checkbox"
                      name="brand"
                      value="<%= brand._id %>"
                      <%= brandId.includes(brand._id.toString()) ? 'checked' : '' %>
                      onchange="updateFilters()"
                    />
                    <%= brand && !brand.isBlocked ? brand.name:'' %>
                  </label>
                </li>
              <% }) %>
            </ul>
          </div>
        </div>

        <div class="price-filter">
          <div class="filter-title">Filter by Price</div>
          <div class="price-options">
            <a href="/shop?price=under500&sort=<%= sort || 'default' %>&<%= categoryId.map(id => `category=${id}`).join('&') %>&<%= brandId.map(id => `brand=${id}`).join('&') %>&query=<%= encodeURIComponent(searchQuery || '') %>">
              <button type="button" class="price-button">Under ₹500</button>
            </a>
            <a href="/shop?price=500-1000&sort=<%= sort || 'default' %>&<%= categoryId.map(id => `category=${id}`).join('&') %>&<%= brandId.map(id => `brand=${id}`).join('&') %>&query=<%= encodeURIComponent(searchQuery || '') %>">
              <button type="button" class="price-button">₹500 - ₹1000</button>
            </a>
            <a href="/shop?price=1000-1500&sort=<%= sort || 'default' %>&<%= categoryId.map(id => `category=${id}`).join('&') %>&<%= brandId.map(id => `brand=${id}`).join('&') %>&query=<%= encodeURIComponent(searchQuery || '') %>">
              <button type="button" class="price-button">₹1000 - ₹1500</button>
            </a>
            <a href="/shop?price=above1500&sort=<%= sort || 'default' %>&<%= categoryId.map(id => `category=${id}`).join('&') %>&<%= brandId.map(id => `brand=${id}`).join('&') %>&query=<%= encodeURIComponent(searchQuery || '') %>">
              <button type="button" class="price-button">Above ₹1500</button>
            </a>
          </div>
        </div>
      </aside>

      <main class="product-grid">
        <% if (products.length === 0) { %>
          <p>No products found.</p>
        <% } else { %>
          <% products.forEach(product => { %>
            <div class="product-card">
              <span
                class="wishlist-btn <%= wishlistItems && wishlistItems.some(item => item.product._id.toString() === product._id.toString()) ? 'active' : '' %>"
                onclick="toggleWishlist('<%= product._id %>', this)"
              >
                <svg viewBox="0 0 24 24">
                  <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
              </span>
              <a href="/productDetails?id=<%= product._id %>">
                <img src="<%= product.productImages[0] %>" alt="<%= product.name %>" />
                <h4><%= product.name %></h4>
                <div class="product-meta">
                  <span class="category-name">
                    <% const category = categories.find(cat => cat._id.toString() === (product.category ? product.category._id.toString() : '')); %>
                    <%= category ? category.name : 'N/A' %>
                  </span>
                  <span class="brand-name">
                    <% const brand = brands.find(b => b._id.toString() === (product.brand ? product.brand._id.toString() : '')); %>
                    <%= brand ? brand.name : 'N/A' %>
                  </span>
                </div>
                <p>
                  ₹<%= product.finalPrice %>
                  <% if (product.finalPrice < product.regularPrice) { %>
                    <span class="original-price">₹<%= product.regularPrice %></span>
                    <% if (product.bestOffer > 0) { %>
                      <span class="text-green-600 text-sm font-medium">(<%= product.bestOffer %>% OFF)</span>
                    <% } %>
                  <% } %>
                </p>
              </a>
              <button
                type="button"
                class="button-add-to-cart flex-1 <%= product.quantity <= 0 || !product.isListed || product.isBlocked ? 'disabled' : '' %>"
                id="addToCart"
                data-product-id="<%= product._id %>"
                data-max-stock="<%= product.quantity %>"
                <%= product.quantity <= 0 || !product.isListed || product.isBlocked ? 'disabled' : '' %>
              >
                <i class="fas fa-shopping-cart mr-2"></i>
                <%= product.quantity <= 0 || !product.isListed || product.isBlocked ? 'Out of Stock' : 'Add to Cart' %>
              </button>
            </div>
          <% }) %>
        <% } %>
      </main>
    </div>
  </section>
</div>

<div class="pagination">
  <% if (currentPage > 1) { %>
    <a href="/shop?page=<%= currentPage - 1 %>&sort=<%= sort || 'default' %>&<%= categoryId.map(id => `category=${id}`).join('&') %>&<%= brandId.map(id => `brand=${id}`).join('&') %>&price=<%= priceRange || '' %>&query=<%= encodeURIComponent(searchQuery || '') %>">Previous</a>
  <% } %>
  <% for (let i = 1; i <= totalPages; i++) { %>
    <a href="/shop?page=<%= i %>&sort=<%= sort || 'default' %>&<%= categoryId.map(id => `category=${id}`).join('&') %>&<%= brandId.map(id => `brand=${id}`).join('&') %>&price=<%= priceRange || '' %>&query=<%= encodeURIComponent(searchQuery || '') %>" class="<%= i === currentPage ? 'active' : '' %>"><%= i %></a>
  <% } %>
  <% if (currentPage < totalPages) { %>
    <a href="/shop?page=<%= currentPage + 1 %>&sort=<%= sort || 'default' %>&<%= categoryId.map(id => `category=${id}`).join('&') %>&<%= brandId.map(id => `brand=${id}`).join('&') %>&price=<%= priceRange || '' %>&query=<%= encodeURIComponent(searchQuery || '') %>">Next</a>
  <% } %>
</div>

<script>
function toggleSidebar() {
    const sidebar = document.querySelector('.sidebar');
    const overlay = document.querySelector('.overlay');
    sidebar.classList.toggle('active');
    overlay.classList.toggle('active');
}
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
 document.addEventListener('DOMContentLoaded', () => {

  
        const cartCountEl = document.getElementById('cart-count');
    if (cartCountEl) {
        const current = parseInt(cartCountEl.innerText, 10) || 0;
        cartCountEl.style.display = current > 0 ? 'inline-block' : 'none';
    }
    
  const addToCartBtns = document.querySelectorAll('.button-add-to-cart');

  addToCartBtns.forEach(btn => {
    btn.addEventListener('click', async () => {
      const productId = btn.getAttribute('data-product-id');
      const qtyInput = btn.closest('.product-card')?.querySelector('.qty-input');
      const quantity = qtyInput ? parseInt(qtyInput.value) : 1;

      btn.classList.add('loading');

      try {
        const response = await fetch(`/add-to-cart/${productId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ quantity }),
        });

        const data = await response.json();

        if (data.success) {

          const cartCountEl=document.getElementById('cart-count');
            if(cartCountEl){
               cartCountEl.innerText=data.cartItemCount;
               cartCountEl.style.display=data.cartItemCount>0?'inline-block':'none'

            }
          
        
          const wishlistBtn = btn.closest('.product-card')?.querySelector('.button-wishlist');
          if (wishlistBtn) {
            wishlistBtn.classList.remove('active');
    
            Swal.fire({
              iconHtml: '<i class="fas fa-wine-bottle custom-swal-perfume-icon"></i>',
              title: 'Removed from Wishlist!',
              showConfirmButton: false,
              timer: 1500,
              toast: true,
              position: 'top-end',
              width: '300px'
            });
          }

          Swal.fire({
            title: 'Perfume Added!',
            text: 'Your perfume is now in the cart 🌸',
            iconHtml: '<i class="fas fa-wine-bottle custom-swal-perfume-icon"></i>',
            showConfirmButton: false,
            timer: 1800,
            toast: true,
            position: 'top-end',
            width: '300px'
          });

        } else {
          Swal.fire({
            title: data.error || 'Failed to add cart',
            text: 'Failed Adding to Cart',
            iconHtml: '<i class="fas fa-wine-bottle custom-swal-perfume-icon"></i>',
            showConfirmButton: false,
            timer: 1500,
            toast: true,
            position: 'top-end',
            width: '300px'
          });
        }

      } catch (error) {
        Swal.fire({
          icon: 'warning',
          title: 'An error occurred. Please try again.',
          showConfirmButton: false,
          timer: 1500,
          toast: true,
          position: 'top-end',
          width: '300px'
        });

      } finally {
        btn.classList.remove('loading');
      }
    });
  });
});


function toggleWishlist(productId, buttonElement) {
  fetch(`/wishlist/${buttonElement.classList.contains('active') ? 'remove' : 'add'}/${productId}`, {
    method: 'POST',
    credentials: 'include',
    headers: { 'Content-Type': 'application/json' },
  })
  .then(res => res.json())
  .then(data => {
    if (data.success) {
      // Set class explicitly based on action
      if (buttonElement.classList.contains('active')) {
        buttonElement.classList.remove('active');
        showWishlistToast('Removed from Wishlist!');
      } else {
        buttonElement.classList.add('active');
        showWishlistToast('Added to Wishlist!');
      }
    } else {
      showWishlistError(data.error || 'Could not update wishlist');
    }
  })
  .catch(err => {
    console.error(err);
    showWishlistError('Something went wrong, confirm you are logged in');
  });
}

// Helper functions for cleaner code
function showWishlistToast(title) {
  Swal.fire({
    iconHtml: '<i class="fas fa-wine-bottle custom-swal-perfume-icon"></i>',
    text: 'Your perfume is now in the wishlist 🌸',
    title,
    showConfirmButton: false,
    timer: 1500,
    toast: true,
    position: 'top-end',
    width: '300px'
  });
}

function showWishlistError(text) {
  Swal.fire({
    icon: 'warning',
    title: 'Error',
    text,
    showConfirmButton: false,
    timer: 1500,
    toast: true,
    position: 'top-end',
    width: '300px'
  });
}



  function updateFilters() {
    const categories = Array.from(document.querySelectorAll('input[name="category"]:checked')).map(input => input.value);
    const brands = Array.from(document.querySelectorAll('input[name="brand"]:checked')).map(input => input.value);
    const sort = document.querySelector('.sort-container select').value;
    const price = '<%= priceRange || "" %>';
    const query = '<%= encodeURIComponent(searchQuery || "") %>';

    let url = '/shop?';
    const params = [];
    if (sort && sort !== 'default') params.push(`sort=${sort}`);
    categories.forEach(cat => params.push(`category=${cat}`));
    brands.forEach(brand => params.push(`brand=${brand}`));
    if (price) params.push(`price=${price}`);
    if (query) params.push(`query=${query}`);
    url += params.join('&');

    window.location.href = url;
  }

  function updateSort(sortValue) {
    const categories = Array.from(document.querySelectorAll('input[name="category"]:checked')).map(input => input.value);
    const brands = Array.from(document.querySelectorAll('input[name="brand"]:checked')).map(input => input.value);
    const price = '<%= priceRange || "" %>';
    const query = '<%= encodeURIComponent(searchQuery || "") %>';

    let url = '/shop?';
    const params = [];
    if (sortValue && sortValue !== 'default') params.push(`sort=${sortValue}`);
    categories.forEach(cat => params.push(`category=${cat}`));
    brands.forEach(brand => params.push(`brand=${brand}`));
    if (price) params.push(`price=${price}`);
    if (query) params.push(`query=${query}`);
    url += params.join('&');

    window.location.href = url;
  }
</script>

