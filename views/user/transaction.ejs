<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Transactions - My Wallet</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .card {
            transition: all 0.3s ease;
            cursor: pointer;
        }
        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }
        @keyframes fadeIn {
            0% { opacity: 0; }
            100% { opacity: 1; }
        }
        .fade-in {
            animation: fadeIn 0.5s ease-in-out forwards;
        }
    </style>
</head>

<body class="bg-gray-50">
    <%- include("../../views/partials/user/header") %>
    <section class="relative py-16 bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900">
        <div class="relative z-10 container mx-auto px-4 text-center text-white">
            <h1 class="text-4xl lg:text-5xl font-bold mb-4">All Transactions</h1>
            <nav class="flex items-center justify-center space-x-2 text-lg">
                <a href="/" class="text-gray-300 hover:text-white transition duration-200">Home</a>
                <i class="fas fa-chevron-right text-gray-400 text-sm"></i>
                <a href="/wallet" class="text-gray-300 hover:text-white transition duration-200">Wallet</a>
                <i class="fas fa-chevron-right text-gray-400 text-sm"></i>
                <span class="text-amber-400">Transactions</span>
            </nav>
        </div>
    </section>

    <main class="py-16">
        <div class="container mx-auto px-4">
            <div class="max-w-7xl mx-auto">
                <div class="bg-white rounded-2xl shadow-xl p-8 fade-in mb-8">
                    <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
                        <i class="fas fa-exchange-alt text-amber-500 mr-3"></i>
                        Filter Transactions
                    </h2>
                    <form method="get" action="/wallet/transactions" class="mb-8 flex flex-wrap gap-4">
                       <% const today = new Date().toISOString().split("T")[0]; %>

<input type="date" name="startDate" 
       value="<%= filters.startDate || '' %>" 
       max="<%= today %>"
       class="border-gray-300 bg-gray-50 p-3 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500">

<input type="date" name="endDate" 
       value="<%= filters.endDate || '' %>" 
       max="<%= today %>"
       class="border-gray-300 bg-gray-50 p-3 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500">

                        <select name="status" class="border-gray-300 bg-gray-50 p-3 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500">
                            <option value="">All Status</option>
                            <option value="Success" <%= filters.status === 'Success' ? 'selected' : '' %>>Success</option>
                            <option value="Pending" <%= filters.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                        </select>
                        <button type="submit" class="bg-amber-500 text-white px-6 py-3 rounded-lg hover:bg-amber-600 transition duration-200">
                            <i class="fas fa-filter mr-2"></i> Filter
                        </button>
                        <a href="/wallet/transactions" 
   class="bg-gray-400 text-white px-6 py-3 rounded-lg hover:bg-gray-500 transition duration-200">
    <i class="fas fa-times mr-2"></i> Clear
</a>

                    </form>

                    <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
                        <i class="fas fa-list text-amber-500 mr-3"></i>
                        Transaction History
                    </h2>
                    <div class="overflow-x-auto">
                        <table class="min-w-full">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="py-3 px-6 text-left text-gray-900 font-semibold">Date</th>
                                    <th class="py-3 px-6 text-left text-gray-900 font-semibold">Description</th>
                                    <th class="py-3 px-6 text-left text-gray-900 font-semibold">Type</th>
                                    <th class="py-3 px-6 text-left text-gray-900 font-semibold">Amount</th>
                                    <th class="py-3 px-6 text-left text-gray-900 font-semibold">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% transactions.forEach(t => { %>
                                    <tr class="hover:bg-gray-100 transition duration-200">
                                        <td class="py-4 px-6 text-gray-600"><%= t.createdAt.toLocaleDateString() %></td>
                                        <td class="py-4 px-6 text-gray-600"><%= t.description %></td>
                                        <td class="py-4 px-6 <%= t.type === 'credit' ? 'text-green-600' : 'text-red-600' %>">
                                            <%= t.type.charAt(0).toUpperCase() + t.type.slice(1) %>
                                        </td>
                                        <td class="py-4 px-6 <%= t.type === 'credit' ? 'text-green-600' : 'text-red-600' %>">
                                            ₹<%= t.amount %>
                                        </td>
                                        <td class="py-4 px-6 text-gray-600"><%= t.status %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Pagination -->
                <div class="bg-white rounded-2xl shadow-xl p-8 fade-in">
                    <div class="flex flex-wrap gap-2 justify-center">
                        <% for (let i = 1; i <= totalPages; i++) { %>
                            <a href="?page=<%= i %>&startDate=<%= filters.startDate || '' %>&endDate=<%= filters.endDate || '' %>&type=<%= filters.type || '' %>&status=<%= filters.status || '' %>"
                               class="px-4 py-2 border border-gray-300 rounded-lg <%= i === currentPage ? 'bg-amber-500 text-white' : 'text-gray-600 hover:bg-amber-500 hover:text-white' %> transition duration-200">
                                <%= i %>
                            </a>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include("../../views/partials/user/footer") %>
</body>
</html>