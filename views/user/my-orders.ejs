<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Orders - Perfuma</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    animation: {
                        'fade-in': 'fadeIn 0.5s ease-in-out',
                        'slide-up': 'slideUp 0.6s ease-out',
                    },
                    keyframes: {
                        fadeIn: {
                            '0%': { opacity: '0' },
                            '100%': { opacity: '1' },
                        },
                        slideUp: {
                            '0%': { transform: 'translateY(30px)', opacity: '0' },
                            '100%': { transform: 'translateY(0)', opacity: '1' },
                        }
                    }
                }
            }
        }
    </script>

    <style>
        .swal2-popup {
    background: #fff0f5;  /* Light lavender */
    color: #333;
    font-family: 'Arial, sans-serif';
}

.custom-swal-perfume-icon {
    font-size: 30px !important;  /* Smaller icon size */
    color: #ff69b4;              /* Pinkish */
}

        .order-card {
            transition: all 0.3s ease;
            cursor: pointer;
        }
        .order-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 50;
            justify-content: center;
            align-items: center;
        }
        .modal-content {
            background: white;
            padding: 24px;
            width: 90%;
            max-width: 500px;
            border-radius: 12px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }
    </style>
</head>
<body class="bg-gray-50 font-sans">
    <%- include("../../views/partials/user/header") %>

    <section class="relative py-16 bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900">
        <div class="relative z-10 container mx-auto px-4 text-center text-white">
            <h1 class="text-4xl lg:text-5xl font-bold mb-4">My Orders</h1>
            <nav class="flex items-center justify-center space-x-2 text-lg">
                <a href="/" class="text-gray-300 hover:text-white transition duration-200">Home</a>
                <i class="fas fa-chevron-right text-gray-400 text-sm"></i>
                <span class="text-amber-400">My Orders</span>
            </nav>
        </div>
    </section>

    <main class="py-16">
        <div class="container mx-auto px-4">
            <div class="max-w-7xl mx-auto">
                <div class="bg-white rounded-2xl shadow-xl p-8 animate-fade-in">
                    
                    <div class="mb-8">
                        <form action="/my-orders" method="get" class="d-inline">
                            <div class="flex justify-center">
                                <div class="relative w-full max-w-md">
                                    <input 
                                        id="searchOrder"
                                        type="text" 
                                        class="w-full border border-gray-200 rounded-full py-3 px-6 text-gray-600 focus:outline-none focus:ring-2 focus:ring-amber-500 bg-gray-50" 
                                        placeholder="Search By Order ID.." 
                                        name="search"
                                    >
                                    <button 
                                        class="absolute right-2 top-1/2 transform -translate-y-1/2 bg-gradient-to-r from-amber-500 to-orange-500 text-white px-4 py-2 rounded-full hover:from-amber-600 hover:to-orange-600 transition duration-300 transform hover:scale-105"
                                        type="submit"
                                    >
                                        Search
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <% if (orders.length === 0) { %>
                        <div class="text-center py-16">
                            <div class="w-24 h-24 bg-gray-200 rounded-full flex items-center justify-center mx-auto mb-6">
                                <i class="fas fa-box-open text-gray-400 text-3xl"></i>
                            </div>
                            <h3 class="text-2xl font-semibold text-gray-900 mb-4">No orders found</h3>
                            <p class="text-gray-600 mb-8">Looks like you haven't placed any orders yet.</p>
                            <a href="/shop" class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-amber-500 to-orange-500 text-white font-semibold rounded-lg hover:from-amber-600 hover:to-orange-600 transition duration-300">
                                <i class="fas fa-shopping-bag mr-2"></i>
                                Continue Shopping
                            </a>
                        </div>
                    <% } else { %>
                        <div class="space-y-6">
                            <% orders.forEach(order => { %>
                                <div class="order-card bg-gray-50 rounded-xl p-6 border border-gray-200">
                                    <div class="flex flex-col md:flex-row items-start md:items-center gap-6">
                                        <div class="flex-shrink-0">
                                            <% const firstItem = order.items[0]; %>
                                            <% if (firstItem && firstItem.product && firstItem.product.productImages && firstItem.product.productImages.length > 0) { %>
                                                <img src="<%= firstItem.product.productImages[0] %>" alt="<%= firstItem.product.name %>" class="w-24 h-24 md:w-32 md:h-32 object-cover rounded-xl shadow-md" />
                                            <% } else { %>
                                                <img src="/images/default-product.png" alt="No Image" class="w-24 h-24 md:w-32 md:h-32 object-cover rounded-xl shadow-md" />
                                            <% } %>
                                        </div>
                                        <div class="flex-1 space-y-3">
                                            <h3 class="text-xl font-semibold text-gray-900">Order ID: <%= order.orderID %></h3>
                                            <p class="text-gray-600 text-sm">Date: <%= new Date(order.createdAt).toLocaleDateString() %></p>
                                            <div class="flex items-center text-2xl font-bold text-amber-600">
                                                ₹<%= order.finalAmount %>
                                            </div>
                                        </div>
                                        <div class="flex flex-col items-center space-y-4">
                                            <div class="flex items-center text-sm">
                                                <%
  const itemStatuses = order.items.map(i => i.orderStatus.trim().toLowerCase());

let displayOrderStatus;

if (itemStatuses.every(s => s === 'cancelled')) {
    displayOrderStatus = 'Cancelled';
} else if (itemStatuses.every(s => s === 'returned')) {
    displayOrderStatus = 'Returned';
} else if (itemStatuses.every(s => s === 'delivered')) {
    displayOrderStatus = 'Delivered';
} else if (itemStatuses.every(s => s === 'out for delivery')) {
    displayOrderStatus = 'Out for Delivery';
} else {
    displayOrderStatus = order.orderStatus;
}


   let orderStatusClass = ['Delivered','Shipped','Processing'].includes(displayOrderStatus)
                          ? 'text-green-600'
                          : 'text-red-600';
%>

<span class="flex items-center <%= orderStatusClass %>">
    <i class="fas fa-circle text-xs mr-2"></i>
    Status: <%= displayOrderStatus %>
</span>

                                            </div>
                                            <% if (order.orderStatus === 'ReturnRequest') { %>
                                                <p class="text-yellow-600 text-sm">Return request pending admin verification...</p>
                                            <% } else if (order.orderStatus === 'Returned') { %>
                                                <p class="text-green-600 text-sm">Return allowed, amount refunded to wallet.</p>
                                            <% } else if (order.orderStatus === 'Delivered' && order.returnRejected) { %>
                                                <p class="text-red-600 text-sm">Return request rejected.</p>
                                             <% } else if (order.orderStatus === 'Pending') { %>
                                                <p class="text-red-600 text-sm">Can not retry after 24 hours</p>

                                            <% } %>
                                            <div class="flex flex-col md:flex-row gap-2">
    <a href="/userOrder-details/<%= order.orderID %>" 
       class="px-4 py-2 bg-gradient-to-r from-amber-500 to-orange-500 text-white rounded-lg hover:from-amber-600 hover:to-orange-600 transition duration-300 transform hover:scale-105">
       View Details
    </a>
<%
const allProcessingOrShipped = order.items.length > 0 &&
    itemStatuses.every(s => s === 'processing' || s === 'shipped');

const allDelivered = order.items.length > 0 &&
    itemStatuses.every(s => s === 'delivered');


%>



<% if (allProcessingOrShipped && order.orderStatus !== 'Delivered' && displayOrderStatus !== 'Cancelled' && order.orderStatus !== 'Pending' && order.orderStatus !== 'Out for Delivery') { %>
    <button onclick="showCancelModal('<%= order.orderID %>')" 
            class="px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition duration-300 transform hover:scale-105">
        Cancel Order
    </button>
<% } %>

 <!-- <pre><%= JSON.stringify(itemStatuses) %></pre> -->



<% if (itemStatuses.length > 0 && itemStatuses.every(s => s === 'delivered')) { %>
    <button 
        onclick="showReturnModal('<%= order.orderID %>')" 
        class="px-4 py-2 bg-gradient-to-r from-amber-500 to-orange-500 text-white rounded-lg hover:from-amber-600 hover:to-orange-600 transition duration-300 transform hover:scale-105 " 
     
    >
        Return Order
    </button>
  
<% } %>







                                                <%
  const orderDate = new Date(order.createdAt);
  const now = new Date();
  const hoursSinceOrder = (now - orderDate) / (1000 *60 * 60);
  const canRetry = order.orderStatus === 'Pending' && hoursSinceOrder <= 24;
%>

<% if (order.orderStatus === 'Pending') { %>
  <% if (canRetry) { %>
    <button 
      onclick="retryOrder('<%= order._id %>')" 
      class="px-4 py-2 bg-gradient-to-r from-amber-500 to-yellow-400 text-white rounded-lg hover:from-amber-600 hover:to-yellow-600 transition duration-300 transform hover:scale-105">
      Retry Payment
    </button>
  <% } else { %>
    <button 
      disabled 
      title="Cannot retry after 24 hours"
      class="px-4 py-2 bg-gray-400 text-white rounded-lg cursor-not-allowed">
      Retry Payment
    </button>
  <% } %>
<% } %>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                        <div class="mt-8 pt-6 border-t border-gray-200">
                            <a href="/shop" class="inline-flex items-center text-amber-600 hover:text-amber-700 font-semibold transition duration-200">
                                <i class="fas fa-arrow-left mr-2"></i>
                                Continue Shopping
                            </a>
                        </div>
                    <% } %>
                </div>

                <div class="pagination-container mt-8 flex justify-center items-center gap-2">
                    <% if (currentPage > 1) { %>
                        <a href="?page=<%= currentPage - 1 %>" class="bg-gray-50 text-amber-600 border-amber-500 hover:bg-amber-500 hover:text-white hover:border-amber-600 px-4 py-2 rounded-lg transition-all duration-200 transform hover:scale-105">« Previous</a>
                    <% } %>
                    <% for (let i = 1; i <= totalPages; i++) { %>
                        <% if (i === currentPage) { %>
                            <span class="current-page bg-amber-500 text-white border-amber-500 px-4 py-2 rounded-lg font-bold"><%= i %></span>
                        <% } else { %>
                            <a href="?page=<%= i %>" class="bg-gray-50 text-amber-600 border-amber-500 hover:bg-amber-500 hover:text-white hover:border-amber-600 px-4 py-2 rounded-lg transition-all duration-200 transform hover:scale-105"><%= i %></a>
                        <% } %>
                    <% } %>
                    <% if (currentPage < totalPages) { %>
                        <a href="?page=<%= currentPage + 1 %>" class="bg-gray-50 text-amber-600 border-amber-500 hover:bg-amber-500 hover:text-white hover:border-amber-600 px-4 py-2 rounded-lg transition-all duration-200 transform hover:scale-105">Next »</a>
                    <% } %>
                </div>
            </div>
        </div>
    </main>

    <div id="cancelModal" class="modal">
        <div class="modal-content">
            <h3 class="text-2xl font-bold text-gray-900 mb-4 flex items-center">
                <i class="fas fa-times-circle text-red-500 mr-2"></i>
                Cancel Order
            </h3>
            <p class="text-gray-600 mb-4">Are you sure you want to cancel order <span id="cancelOrderID" class="font-semibold"></span>?</p>
            <textarea id="cancelReason" placeholder="Reason for cancellation (optional)" class="w-full border border-gray-200 rounded-lg p-2 mb-4"></textarea>
            <div class="flex justify-end gap-2">
                <button onclick="closeModal('cancel')" class="px-4 py-2 bg-gray-300 text-gray-800 rounded-lg hover:bg-gray-400 transition duration-300 transform hover:scale-105">Close</button>
                <button onclick="confirmCancel()" class="px-4 py-2 bg-gradient-to-r from-amber-500 to-orange-500 text-white rounded-lg hover:from-amber-600 hover:to-orange-600 transition duration-300 transform hover:scale-105">Confirm Cancel</button>
            </div>
        </div>
    </div>

    <div id="returnModal" class="modal">
        <div class="modal-content">
            <h3 class="text-2xl font-bold text-gray-900 mb-4 flex items-center">
                <i class="fas fa-undo text-amber-500 mr-2"></i>
                Return Order
            </h3>
            <p class="text-gray-600 mb-4">Are you sure you want to return order <span id="returnOrderID" class="font-semibold"></span>?</p>
            <textarea id="returnReason" placeholder="Reason for return (mandatory)" class="w-full border border-gray-200 rounded-lg p-2 mb-4" required></textarea>
            <div class="flex justify-end gap-2">
                <button onclick="closeModal('return')" class="px-4 py-2 bg-gray-300 text-gray-800 rounded-lg hover:bg-gray-400 transition duration-300 transform hover:scale-105">Close</button>
                <button onclick="confirmReturn()" class="px-4 py-2 bg-gradient-to-r from-amber-500 to-orange-500 text-white rounded-lg hover:from-amber-600 hover:to-orange-600 transition duration-300 transform hover:scale-105">Confirm Return</button>
            </div>
        </div>
    </div>

    <div id="order-successful-modal" class="fixed inset-0 bg-gray-900 bg-opacity-75 flex items-center justify-center p-4 z-50 hidden animate-fade-in"> <div class="bg-white rounded-2xl shadow-2xl p-8 max-w-lg w-full text-center animate-slide-up transform scale-95 opacity-0" id="order-successful-content"> <div class="w-32 h-32 mx-auto mb-6"> <img src="https://cdn-icons-png.flaticon.com/512/845/845646.png" alt="Success Tick" class="w-20 h-20 mx-auto mb-6"> </div> <h2 class="text-3xl font-bold text-green-600 mb-4">Order Placed Successfully!</h2> <p class="text-gray-700 text-lg mb-8">Thank you for your purchase. Your order has been confirmed and will be processed shortly.</p> <div class="flex flex-col sm:flex-row justify-center gap-4"> <button class="view-order-details-btn px-8 py-4 bg-amber-500 text-white font-semibold rounded-lg hover:bg-amber-600 transition duration-300"> <i class="fas fa-clipboard-list mr-2"></i> View Order Details </button> <button class="continue-shopping-btn px-8 py-4 border border-gray-300 text-gray-800 font-semibold rounded-lg hover:bg-gray-100 transition duration-300"> <i class="fas fa-shopping-bag mr-2"></i> Continue Shopping </button> </div> </div> </div> <div id="order-failed-modal" class="fixed inset-0 bg-gray-900 bg-opacity-75 flex items-center justify-center p-4 z-50 hidden animate-fade-in"> <div class="bg-white rounded-2xl shadow-2xl p-8 max-w-lg w-full text-center animate-slide-up transform scale-95 opacity-0" id="order-failed-content"> <div class="w-32 h-32 mx-auto mb-6"> <img src="https://cdn-icons-png.flaticon.com/512/463/463612.png" alt="Failure Cross" class="w-20 h-20 mx-auto mb-6"> </div> <h2 class="text-3xl font-bold text-red-600 mb-4">Payment Failed</h2> <p class="text-gray-700 text-lg mb-8">Oops! Something went wrong while processing your payment. Please try again or use a different method.</p> <div class="flex flex-col sm:flex-row justify-center gap-4"> <button onclick="closeModal(order-failed-modal, order-failed-content)" class="close-modal-btn px-8 py-4 border border-gray-300 text-gray-800 font-semibold rounded-lg hover:bg-gray-100 transition duration-300"> <i class="fas fa-times-circle mr-2"></i> Cancel </button> </div> </div> </div>


    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script>
          const viewOrderDetailsBtn = document.querySelector('.view-order-details-btn');
            const continueShoppingBtn = document.querySelector('.continue-shopping-btn');

        function openModal(modalId, contentId) {
    const modal = document.getElementById(modalId);
    const content = document.getElementById(contentId);
    if (modal && content) {
        modal.classList.remove('hidden');   // show modal
        content.classList.add('animate-slide-up');
        content.classList.remove('opacity-0', 'scale-95');
    }
}

        let currentReturnOrderID = null;

        function showCancelModal(orderID) {
            const modal = document.getElementById('cancelModal');
            document.getElementById('cancelOrderID').textContent = orderID;
            modal.style.display = 'flex';
            document.getElementById('cancelReason').value = '';
        }

        function showReturnModal(orderID) {
            const modal = document.getElementById('returnModal');
            document.getElementById('returnOrderID').textContent = orderID;
            currentReturnOrderID = orderID;
            modal.style.display = 'flex';
            document.getElementById('returnReason').value = '';
        }

        function closeModal(type) {
            document.getElementById(type === 'cancel' ? 'cancelModal' : 'returnModal').style.display = 'none';
        }

        async function confirmCancel() {
            const orderID = document.getElementById('cancelOrderID').textContent.trim();
            const reason = document.getElementById('cancelReason').value.trim();

            try {
                const response = await fetch(`/cancel-order/${orderID}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ reason })
                });

                const data = await response.json();

                if (response.ok) {
                     Swal.fire({
            title: 'Order cancelled!',
            text: data.message || 'your Order cancelled successfully🌸',
            iconHtml: '<i class="fas fa-wine-bottle custom-swal-perfume-icon"></i>',
            showConfirmButton: false,
            timer: 1800,
            toast: true,
            position: 'top-end',
            width: '300px'
          })
                  
                    closeModal('cancel');
                    setTimeout(() => location.reload(), 1000);
                } else {
                     Swal.fire({
    icon: 'error',
    title: 'Error',
    text: data.message || 'failed to cancel order',
    showConfirmButton: false,
    timer: 1800,
    toast: true,
    position: 'top-end',
    width: '300px'
  });
                    
                }
            } catch (error) {
                console.error('Cancel order error:', error);
                 Swal.fire({
    icon: 'error',
    title: 'Error',
    text: 'Something went wrong ,Please try again',
    showConfirmButton: false,
    timer: 1800,
    toast: true,
    position: 'top-end',
    width: '300px'
  });
                
            }
        }

        async function confirmReturn() {
            const reason = document.getElementById('returnReason').value.trim();

            if (!reason) {
                 Swal.fire({
    icon: 'error',
    title: 'Error',
    text: 'Please provide a reasong for return',
    showConfirmButton: false,
    timer: 1800,
    toast: true,
    position: 'top-end',
    width: '300px'
  });
               
                return;
            }

            if (!currentReturnOrderID) {
                 Swal.fire({
    icon: 'error',
    title: 'Error',
    text: 'Invalid Order Id',
    showConfirmButton: false,
    timer: 1800,
    toast: true,
    position: 'top-end',
    width: '300px'
  });
               
                return;
            }

            try {
                console.log("Submitting return for Order ID:", currentReturnOrderID);

                const response = await fetch(`/return-order/${currentReturnOrderID}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ reason, action: 'request' })
                });

                const data = await response.json();

                if (response.ok) {
                     Swal.fire({
            title: 'Return request',
            text:data.message || 'Return request submitted successfully🌸',
            iconHtml: '<i class="fas fa-wine-bottle custom-swal-perfume-icon"></i>',
            showConfirmButton: false,
            timer: 1800,
            toast: true,
            position: 'top-end',
            width: '300px'
          })
                    
                    closeModal('return');
                    setTimeout(() => location.reload(), 1000);
                } else {
                     Swal.fire({
    icon: 'error',
    title: 'Error',
    text: data.message || 'Failed to submit return request',
    showConfirmButton: false,
    timer: 1800,
    toast: true,
    position: 'top-end',
    width: '300px'
  });
                   
                }
            } catch (error) {
                console.error('Return order error:', error);
                 Swal.fire({
    icon: 'error',
    title: 'Error',
    text: 'Something went wrong,Please try again',
    showConfirmButton: false,
    timer: 1800,
    toast: true,
    position: 'top-end',
    width: '300px'
  });
               
            }
        }

        function searchOrders() {
            const searchTerm = document.getElementById('searchOrder').value;
            window.location.href = `/my-orders?search=${encodeURIComponent(searchTerm)}`;
        }


        
    window.retryOrder = async function(orderId) {
        if (!orderId) {
             Swal.fire({
    icon: 'error',
    title: 'Error',
    text:  'Order Not found to retry',
    showConfirmButton: false,
    timer: 1800,
    toast: true,
    position: 'top-end',
    width: '300px'
  });
           
            return;
        }

        try {
          
            const response = await fetch('/retry-payment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ orderId })
            });

            const result = await response.json();

            if (!result.success) {
                 Swal.fire({
    icon: 'error',
    title: 'Error',
    text: data.message || 'Failed to initiate retry payment',
    showConfirmButton: false,
    timer: 1800,
    toast: true,
    position: 'top-end',
    width: '300px'
  });
               
                return;
            }

     
            const options = {
                key: result.key,
                amount: result.amount,
                currency: result.currency,
                order_id: result.razorpayOrderId,
                name: 'Perfuma',
                description: 'Retry Order Payment',
                handler: async function(paymentResponse) {
                    try {
                        
                        const verifyResponse = await fetch('/verify-payment', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                orderId,
                                razorpay_payment_id: paymentResponse.razorpay_payment_id,
                                razorpay_order_id: paymentResponse.razorpay_order_id,
                                razorpay_signature: paymentResponse.razorpay_signature
                            })
                        });

                        const verifyResult = await verifyResponse.json();

                        if (verifyResult.success) {
                           openModal('order-successful-modal', 'order-successful-content');

                        } else {
                            openModal('order-failed-modal', 'order-failed-content');
                        }
                    } catch (err) {
                        console.error('Error verifying retry payment:', err);
                         Swal.fire({
    icon: 'error',
    title: 'Error',
    text: 'Error during payment verification',
    showConfirmButton: false,
    timer: 1800,
    toast: true,
    position: 'top-end',
    width: '300px'
  });
                       
                    }
                },
                theme: { color: '#6366f1' }
            };

        
            const rzp = new Razorpay(options);
            rzp.open();

        } catch (error) {
            console.error('Retry order error:', error);
             Swal.fire({
    icon: 'error',
    title: 'Error',
    text: ' failed to retry payment',
    showConfirmButton: false,
    timer: 1800,
    toast: true,
    position: 'top-end',
    width: '300px'
  });
            
        }
    };


viewOrderDetailsBtn.addEventListener('click', () => {

        window.location.href = `/order-details/${window.latestOrderId}`;

});

continueShoppingBtn.addEventListener('click', () => {
    window.location.href = '/shop';
});

        
    </script>

    <%- include("../../views/partials/user/footer") %>
</body>
</html>
