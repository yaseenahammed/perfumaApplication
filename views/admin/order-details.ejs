 <%- include('../../views/partials/admin/header') %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>-Order Details - Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }
        .modal-content {
            background-color: white;
            padding: 20px;
            border-radius: 8px;
            width: 90%;
            max-width: 500px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }
    </style>
</head>
<body class="bg-gray-50">
   

    <main class="main-wrap">
        <div class="container mx-auto px-4">
            <div class="max-w-5xl mx-auto bg-white rounded-2xl shadow-xl p-8 mt-6">
                <!-- Order Meta Information -->
                <div class="mb-6">
                    <h2 class="text-2xl font-bold text-gray-900 mb-4">Order Details: <%= order.orderID || 'N/A' %></h2>
                    <p><strong>Date:</strong> <%= order.createdAt ? new Date(order.createdAt).toLocaleDateString() : 'N/A' %></p>
                    <p><strong>User:</strong> <%= order.user?.name || 'Unknown' %></p>
                    <p><strong>Status:</strong> <%= order.orderStatus || 'N/A' %></p>
                    <p><strong>Total:</strong> ₹<%= order.finalAmount?.toFixed(2) || '0.00' %></p>
                    <p><strong>Payment Method:</strong> <%= order.paymentMethod || 'N/A' %></p>
                </div>

                <!-- Items Section -->
                <div class="mt-8">
                    <h3 class="text-lg font-semibold mb-4">Items:</h3>
                    <% if (order.items && Array.isArray(order.items) && order.items.length > 0) { %>
                        <div class="space-y-4">
                            <% order.items.forEach(item => { %>
                                <div class="flex items-center justify-between p-4 border rounded-lg shadow-sm bg-gray-50">
                                    <div class="flex items-center gap-4">
                                        <img 
                                            src="<%= item.product?.productImages?.[0] || '/images/default-product.png' %>" 
                                            alt="<%= item.product?.name || item.name || 'Product' %>" 
                                            class="w-16 h-16 object-cover rounded"
                                        >
                                        <div>
                                            <p class="font-semibold"><%= (item.product && item.product.name ? item.product.name : 'Unknown Product') %></p>
                                            <p class="text-sm text-gray-600">Qty: <%= item.quantity || 'N/A' %></p>
                                             <p class="text-sm text-gray-600">Price: ₹<%= item.price?.toFixed(2) || '0.00' %></p>
                                            <p class="text-sm text-red-600">Status: <%= item.orderStatus %></p>
                                           
                                        </div>
                                    </div>
                                    <% if (  item.orderStatus === 'ReturnRequest' && item.orderStatus !== 'Returned' && !item.returnRejectReason) { %>
                                        <button
                                            onclick="showItemReturnModal(
                                                '<%= order.orderID || '' %>', 
                                                '<%= item._id || '' %>', 
                                                '<%= item.name %>', 
                                                '<%= item.quantity || '0' %>', 
                                                '<%= item.price?.toFixed(2) || '0.00' %>', 
                                                '<%= item.returnReason || 'No reason provided' %>'
                                            )"
                                            class="px-4 py-2 bg-green-500 text-white rounded-lg hover:bg-green-600 w-full sm:w-auto block text-center mt-2"
                                        >
                                            Verify Return <%= item.name || 'Item' %>
                                        </button>
                                    <% } %>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <p class="text-center text-gray-600 text-sm">No items found for this order.</p>
                    <% } %>
                </div>

                <!-- Back Button -->
                <div class="mt-6">
                    <a href="/admin/orderList" class="px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600">Back to Orders</a>
                </div>

                <!-- Item Return Verification Modal -->
                <div id="itemReturnModal" class="modal">
                    <div class="modal-content">
                        <h3 class="text-lg font-bold mb-4">Verify Return for Item <span id="itemModalName"></span></h3>
                        <p class="mb-2">Order ID: <span id="itemModalOrderID"></span></p>
                        <p class="mb-2">Quantity: <span id="itemModalQty"></span></p>
                        <p class="mb-2">Price: ₹<span id="itemModalPrice"></span></p>
                        <p class="mb-2">Return Reason: <span id="itemModalReturnReason"></span></p>
                        <div class="flex justify-end gap-2">
                            <button onclick="verifyItemReturn('allow')" class="px-4 py-2 bg-green-500 text-white rounded-lg hover:bg-green-600">Allow</button>
                            <button onclick="verifyItemReturn('reject')" class="px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600">Reject</button>
                            <button onclick="closeItemReturnModal()" class="px-4 py-2 bg-gray-300 text-gray-800 rounded-lg hover:bg-gray-400">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('../../views/partials/admin/footer') %>
</body>
</html>

<script>
    let currentItemID = null;
    let currentItemOrderID = null;

    function showItemReturnModal(orderID, itemID, itemName, qty, price, returnReason) {
        if (!orderID || !itemID) {
            showAlert('Invalid order or item ID.');
            return;
        }

        currentItemID = itemID;
        currentItemOrderID = orderID;

        document.getElementById('itemModalOrderID').textContent = orderID;
        document.getElementById('itemModalName').textContent = itemName || 'Unknown Item';
        document.getElementById('itemModalQty').textContent = qty || 'N/A';
        document.getElementById('itemModalPrice').textContent = price || '0.00';
        document.getElementById('itemModalReturnReason').textContent = returnReason || 'No reason provided';

        document.getElementById('itemReturnModal').style.display = 'flex';
    }

    function closeItemReturnModal() {
        document.getElementById('itemReturnModal').style.display = 'none';
        currentItemID = null;
        currentItemOrderID = null;
    }

    function showAlert(message) {
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                text: message,
                icon: 'error',
                confirmButtonText: 'OK'
            });
        } else {
            alert(message);
        }
    }

    async function verifyItemReturn(action) {
        if (!currentItemID || !currentItemOrderID) {
            showAlert('No item or order selected.');
            return;
        }

        const endpoint = action === 'allow' 
            ? `/admin/verify-returnItem/${currentItemOrderID}/${currentItemID}` 
            : `/admin/reject-returnItem/${currentItemOrderID}/${currentItemID}`;
        const message = action === 'allow' 
            ? 'Item return verified and amount refunded.' 
            : 'Item return request rejected.';

        try {
            const response = await fetch(endpoint, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    // Add CSRF token if available (replace 'getCsrfToken()' with your actual method)
                    // 'X-CSRF-Token': getCsrfToken()
                },
            });

            if (!response.ok) {
                throw new Error(`HTTP error! Status: ${response.status}`);
            }

            const data = await response.json();

            if (data.success) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        text: message,
                        icon: 'success',
                        confirmButtonText: 'OK'
                    }).then(() => {
                        closeItemReturnModal();
                        location.reload();
                    });
                } else {
                    alert(message);
                    closeItemReturnModal();
                    location.reload();
                }
            } else {
                showAlert(data.message || `Error ${action}ing item return.`);
            }
        } catch (err) {
            showAlert('Network error. Please try again.');
            console.error('Fetch error:', err);
        }
    }

    // Close modal when clicking outside
    document.getElementById('itemReturnModal').addEventListener('click', (e) => {
        if (e.target === document.getElementById('itemReturnModal')) {
            closeItemReturnModal();
        }
    });
</script>