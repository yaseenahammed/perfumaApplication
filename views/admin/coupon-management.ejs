<%- include("../../views/partials/admin/header") %>

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Coupon Management - Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        body {
            margin: 0;
            min-height: 100vh;
            font-family: 'Roboto', sans-serif;
            overflow-x: hidden;
        }

        .main-wrap {
            margin-left: 250px;
            padding: 15px;
            min-height: 25vh;
            transition: margin-left 0.3s ease;
            box-sizing: border-box;
            width: calc(100% - 250px);
        }

        .coupon-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .coupon-table th,
        .coupon-table td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #e5e7eb;
            vertical-align: middle;
        }

        .coupon-table th {
            background-color: #f9fafb;
            font-weight: 600;
            color: #1f2937;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .coupon-table td {
            word-wrap: break-word;
        }

        .status-btn {
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.75rem;
            display: inline-block;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1000;
        }

        .modal-content {
            background: white;
            margin: 10% auto;
            padding: 20px;
            width: 90%;
            max-width: 500px;
            border-radius: 8px;
        }

        @media (max-width: 768px) {
            .main-wrap {
                margin-left: 0;
                padding: 10px;
                width: 100%;
            }

            .coupon-table {
                display: block;
                overflow-x: auto;
            }

            .coupon-table th,
            .coupon-table td {
                min-width: 100px;
                font-size: 0.9rem;
            }

            .coupon-table th {
                white-space: nowrap;
            }
        }
    </style>
</head>

<body class="bg-gray-50">

    <main class="main-wrap">
        <div class="container mx-auto px-4">
            <div class="max-w-7xl mx-auto">
                <div class="bg-white rounded-2xl shadow-xl p-6">

                    <!-- Title Section -->
                    <div class="text-center mb-6">
                        <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 flex items-center justify-center">
                            <i class="fas fa-ticket-alt text-amber-500 mr-3"></i>
                            Coupon Management
                        </h2>
                    </div>

                    <!-- Search & Filter -->
                    <header class="text-center mb-8">
                        <form action="/admin/coupon" method="get"
                            class="flex flex-col items-center gap-6 max-w-lg mx-auto">

                            <div class="relative w-full">
                                <input id="searchCoupon" name="search" type="text" value="<%= search %>"
                                    placeholder="Search By Coupon Code..."
                                    class="w-full border border-gray-200 rounded-full py-3 px-6 text-gray-600 focus:outline-none focus:ring-2 focus:ring-amber-500 bg-gray-50" />
                                <button type="submit"
                                    class="absolute right-2 top-1/2 transform -translate-y-1/2 bg-gradient-to-r from-amber-500 to-orange-500 text-white px-4 py-2 rounded-full hover:from-amber-600 hover:to-orange-600 transition duration-300">
                                    Search
                                </button>
                            </div>

                            <div class="flex flex-wrap justify-center gap-4 w-full">
                                <select name="isList" id="filterIsList"
                                    class="border border-gray-200 rounded-lg py-2 px-4 focus:outline-none focus:ring-2 focus:ring-amber-500 w-40">
                                    <option value="" <%= isList === '' ? 'selected' : '' %>>Filter by</option>
                                    <option value="true" <%= isList === 'true' ? 'selected' : '' %>>Listed</option>
                                    <option value="false" <%= isList === 'false' ? 'selected' : '' %>>Unlisted</option>
                                </select>
                            </div>

                            <div class="flex flex-wrap justify-center gap-4">
                                <button type="submit"
                                    class="px-4 py-2 bg-amber-500 text-white rounded-lg hover:bg-amber-600">
                                    Filter
                                </button>

                                <button type="button" id="clearFilters"
                                    class="px-4 py-2 bg-gray-300 text-gray-800 rounded-lg hover:bg-gray-400">
                                    Clear
                                </button>

                                <button type="button" id="createCouponBtn" onclick="showCreateCouponModal()"
                                    class="px-4 py-2 bg-green-500 text-white rounded-lg hover:bg-green-600">
                                    Add New Coupon
                                </button>
                            </div>
                        </form>

                        <div id="couponList" class="space-y-6 mt-8">
                            <% coupons = coupons || []; %>
                            <% if (coupons.length === 0) { %>
                                <p class="text-center text-gray-600">No coupons found.</p>
                            <% } else { %>
                                <table class="coupon-table w-full text-left border-collapse">
                                    <thead>
                                        <tr>
                                            <th>Coupon Code</th>
                                            <th>Discount (₹)</th>
                                            <th>Min Order (₹)</th>
                                            <th>Expires On</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% coupons.forEach(coupon => { %>
                                            <tr>
                                                <td><%= coupon.couponCode %></td>
                                                <td>₹<%= coupon.discountPrice %></td>
                                                <td>₹<%= coupon.minPrice %></td>
                                                <td><%= new Date(coupon.expireOn).toLocaleDateString() %></td>
                                                <% const isListed = coupon.isList === true || coupon.isList === 'true'; %>
                                                <td>
                                                    <span
                                                        class="status-btn <%= isListed ? 'bg-blue-200 text-blue-800' : 'bg-gray-200 text-gray-800' %>">
                                                        <%= isListed ? 'Listed' : 'Unlisted' %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <button
                                                        onclick="showEditCouponModal('<%= coupon.couponCode %>', <%= coupon.discountPrice %>, <%= coupon.minPrice %>, '<%= new Date(coupon.expireOn).toISOString().split('T')[0] %>', <%= coupon.isList %>)"
                                                        class="px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 w-full sm:w-auto mb-2 block text-center">
                                                        Edit
                                                    </button>
                                                    <button
                                                        onclick="deleteCoupon('<%= coupon.couponCode %>')"
                                                        class="px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 w-full sm:w-auto block text-center">
                                                        Delete
                                                    </button>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            <% } %>
                        </div>

                        <div class="pagination-container mt-8 flex justify-center items-center gap-2">
                            <% if (currentPage > 1) { %>
                                <a href="?page=<%= currentPage - 1 %>"
                                    class="bg-gray-50 text-amber-600 border-amber-500 hover:bg-amber-500 hover:text-white hover:border-amber-600 px-4 py-2 rounded-lg transition-all duration-200">«
                                    Previous</a>
                            <% } %>
                            <% for (let i = 1; i <= totalPages; i++) { %>
                                <% if (i === currentPage) { %>
                                    <span
                                        class="current-page bg-amber-500 text-white border-amber-500 px-4 py-2 rounded-lg font-bold"><%= i %></span>
                                <% } else { %>
                                    <a href="?page=<%= i %>"
                                        class="bg-gray-50 text-amber-600 border-amber-500 hover:bg-amber-500 hover:text-white hover:border-amber-600 px-4 py-2 rounded-lg transition-all duration-200"><%= i %></a>
                                <% } %>
                            <% } %>
                            <% if (currentPage < totalPages) { %>
                                <a href="?page=<%= currentPage + 1 %>"
                                    class="bg-gray-50 text-amber-600 border-amber-500 hover:bg-amber-500 hover:text-white hover:border-amber-600 px-4 py-2 rounded-lg transition-all duration-200">Next
                                    »</a>
                            <% } %>
                        </div>

                    </header>

                </div>
            </div>
        </div>
    </main>

    <!-- Coupon Modal -->
    <div id="couponModal" class="modal">
        <div class="modal-content">
            <h3 id="modalTitle" class="text-xl font-semibold mb-4">Create/Edit Coupon</h3>
            <form id="couponForm" method="POST">
                <div class="mb-4">
                    <label for="couponCode">Coupon Code:</label>
                    <input type="text" id="couponCode" name="couponCode"
                        class="w-full border rounded px-3 py-2" required>
                </div>
                <div class="mb-4">
                    <label for="discountPrice">Discount Price (₹):</label>
                    <input type="number" id="discountPrice" name="discountPrice"
                        class="w-full border rounded px-3 py-2" required>
                </div>
                <div class="mb-4">
                    <label for="minPrice">Minimum Order Price (₹):</label>
                    <input type="number" id="minPrice" name="minPrice"
                        class="w-full border rounded px-3 py-2" required>
                </div>
                <div class="mb-4">
                    <label for="expireOn">Expire On:</label>
                    <input type="date" id="expireOn" name="expireOn"
                        class="w-full border rounded px-3 py-2" required>
                </div>
                <div class="mb-4">
                    <label for="isList">Listed?</label>
                    <select id="isList" name="isList"
                        class="w-full border rounded px-3 py-2">
                        <option value="true">Listed</option>
                        <option value="false">Unlisted</option>
                    </select>
                </div>
                <button type="submit" id="saveButton"
                    class="px-4 py-2 bg-green-500 text-white rounded-lg">Save</button>
                <button type="button" onclick="closeCouponModal()"
                    class="px-4 py-2 bg-gray-500 text-white rounded-lg">Cancel</button>
            </form>
        </div>
    </div>

    <script>
        function showCreateCouponModal() {
            document.getElementById('modalTitle').textContent = 'Create New Coupon';
            document.getElementById('couponForm').action = '/admin/coupon/create';
            document.getElementById('couponCode').value = '';
            document.getElementById('discountPrice').value = '';
            document.getElementById('minPrice').value = '';
            document.getElementById('expireOn').value = '';
            document.getElementById('isList').value = 'true';
            document.getElementById('couponCode').disabled = false;
            document.getElementById('saveButton').textContent = 'Create';
            document.getElementById('couponModal').style.display = 'block';
        }

        function openCouponModal({ 
    mode = 'create', // 'create' or 'edit'
    couponCode = '', 
    discountPrice = '', 
    minPrice = '', 
    expireOn = '', 
    isList = true 
} = {}) {
    // Set modal title
    document.getElementById('modalTitle').textContent = mode === 'edit' ? 'Edit Coupon' : 'Create New Coupon';

    // Set form action
    document.getElementById('couponForm').action = mode === 'edit' 
        ? `/admin/coupon/update/${couponCode}` 
        : '/admin/coupon/create';

    // Fill form fields
    document.getElementById('couponCode').value = couponCode;
    document.getElementById('discountPrice').value = discountPrice;
    document.getElementById('minPrice').value = minPrice;
    document.getElementById('expireOn').value = expireOn;
    document.getElementById('isList').value = isList ? 'true' : 'false';

    // Disable coupon code field if editing
    document.getElementById('couponCode').disabled = mode === 'edit';

    // Update save button text
    document.getElementById('saveButton').textContent = mode === 'edit' ? 'Update' : 'Create';

    // Show modal
    document.getElementById('couponModal').style.display = 'block';
}

// Old helper for create
function showCreateCouponModal() {
    openCouponModal(); // defaults to 'create' mode
}

// Old helper for edit
function showEditCouponModal(couponCode, discountPrice, minPrice, expireOn, isList) {
    openCouponModal({
        mode: 'edit',
        couponCode,
        discountPrice,
        minPrice,
        expireOn,
        isList
    });
}

function closeCouponModal() {
    document.getElementById('couponModal').style.display = 'none';
}

        function closeCouponModal() {
            document.getElementById('couponModal').style.display = 'none';
        }

        const expireInput = document.getElementById('expireOn');
        const today = new Date().toISOString().split('T')[0];
        expireInput.setAttribute('min', today);

        document.getElementById('couponForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const action = document.getElementById('couponForm').action;
            const isEdit = action.includes('update');
            const couponData = {
                couponCode: document.getElementById('couponCode').value.trim(),
                discountPrice: parseFloat(document.getElementById('discountPrice').value),
                minPrice: parseFloat(document.getElementById('minPrice').value),
                expireOn: document.getElementById('expireOn').value,
                isList: document.getElementById('isList').value === 'true'
            };

            if (!couponData.couponCode || isNaN(couponData.discountPrice) || isNaN(couponData.minPrice) || !couponData.expireOn) {
                Swal.fire('Error', 'Please fill all fields correctly.', 'error');
                return;
            }

            if (couponData.discountPrice >= couponData.minPrice) {
                Swal.fire('Error', 'Discount price must be less than min order price.', 'error');
                return;
            }

            const response = await fetch(action, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(couponData)
            });

            const data = await response.json();
            if (data.success) {
                Swal.fire('Success', isEdit ? 'Coupon updated.' : 'Coupon created.', 'success').then(() => {
                    closeCouponModal();
                    location.reload();
                });
            } else {
                Swal.fire('Error', data.message || 'Operation failed', 'error');
            }
        });

        function deleteCoupon(couponCode) {
            Swal.fire({
                title: 'Are you sure?',
                text: "This action cannot be undone!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/admin/coupon/delete/${couponCode}`, { method: 'POST' })
                        .then(response => {
                            if (response.ok) {
                                Swal.fire('Deleted!', 'Coupon deleted.', 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Error', 'Failed to delete coupon.', 'error');
                            }
                        });
                }
            });
        }

        document.getElementById('clearFilters').addEventListener('click', () => {
            document.getElementById('searchCoupon').value = '';
            document.getElementById('filterIsList').value = '';
            window.location.href = '/admin/coupon';
        });
    </script>

    <%- include("../../views/partials/admin/footer") %>
</body>

</html>
