 <%- include("../partials/admin/header") %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Management - Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    animation: {
                        'fade-in': 'fadeIn 0.5s ease-in-out',
                        'slide-up': 'slideUp 0.6s ease-out',
                    },
                    keyframes: {
                        fadeIn: {
                            '0%': { opacity: '0' },
                            '100%': { opacity: '1' },
                        },
                        slideUp: {
                            '0%': { transform: 'translateY(30px)', opacity: '0' },
                            '100%': { transform: 'translateY(0)', opacity: '1' },
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            margin: 0;
            min-height: 100vh;
            font-family: 'Roboto', sans-serif;
            overflow-x: hidden;
        }
        .main-wrap {
            margin-left: 250px;
            padding: 15px;
            min-height: 25vh;
            transition: margin-left 0.3s ease;
            box-sizing: border-box;
            width: calc(100% - 250px);
        }
        .btn-block, .status-btn {
            transition: all 0.3s ease;
        }
        .btn-block:hover, .status-btn:hover {
            transform: scale(1.05);
        }
        .table-row {
            transition: all 0.3s ease;
        }
        .table-row:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }
        .order-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }
        .order-table th, .order-table td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #e5e7eb;
            vertical-align: middle;
        }
        .order-table th {
            background-color: #f9fafb;
            font-weight: 600;
            color: #1f2937;
            position: sticky;
            top: 0;
            z-index: 10;
        }
        .order-table td {
            word-wrap: break-word;
        }
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 50;
        }
        .modal-content {
            background: white;
            margin: 15% auto;
            padding: 20px;
            width: 90%;
            max-width: 500px;
            border-radius: 8px;
        }
        @media (max-width: 768px) {
            .main-wrap {
                margin-left: 0;
                padding: 10px;
                width: 100%;
            }
            .order-table {
                display: block;
                overflow-x: auto;
            }
            .order-table th, .order-table td {
                min-width: 100px;
                font-size: 0.9rem;
            }
            .order-table th {
                white-space: nowrap;
            }
        }
    </style>
</head>
<body class="bg-gray-50">
   

    <main class="main-wrap">
        <div class="container mx-auto px-4">
            <div class="max-w-7xl mx-auto">
                <div class="bg-white rounded-2xl shadow-xl p-6 animate-slide-up">
                    <!-- Title Section -->
                    <div class="text-center mb-6">
                        <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 flex items-center justify-center animate-fade-in">
                            <i class="fas fa-box-open text-amber-500 mr-3"></i>
                            Order Management
                        </h2>
                    </div>

                    <!-- Search, Sort, Filter Section -->
                    <header class="text-center mb-8">
  <form action="/admin/order" method="get" class="flex flex-col items-center gap-6">
    <div class="relative w-full max-w-md">
      <input 
        id="searchOrder"
        type="text" 
        class="w-full border border-gray-200 rounded-full py-3 px-6 text-gray-600 focus:outline-none focus:ring-2 focus:ring-amber-500 bg-gray-50" 
        placeholder="Search By Order ID.." 
        name="search"
      >
      <button 
        class="absolute right-2 top-1/2 transform -translate-y-1/2 bg-gradient-to-r from-amber-500 to-orange-500 text-white px-4 py-2 rounded-full hover:from-amber-600 hover:to-orange-600 transition-all duration-300"
        type="submit"
      >
        Search
      </button>
    </div>

    <div class="flex flex-wrap justify-center items-center gap-4">
      <select id="sortOrder" class="border border-gray-200 rounded-lg py-2 px-4 focus:outline-none focus:ring-2 focus:ring-amber-500 w-full sm:w-40" onchange="searchOrders()">
        <option value="desc">Newest First</option>
        <option value="asc">Oldest First</option>
      </select>

      <select id="filterStatus" class="border border-gray-200 rounded-lg py-2 px-4 focus:outline-none focus:ring-2 focus:ring-amber-500 w-full sm:w-48" onchange="searchOrders()">
        <option value="">All Statuses</option>
        <option value="Processing">Processing</option>
        <option value="Shipped">Shipped</option>
        <option value="Out for Delivery">Out for Delivery</option>
        <option value="Delivered">Delivered</option>
        <option value="Cancelled">Cancelled</option>
        <option value="ReturnRequest">Return Request</option>
        <option value="Returned">Returned</option>
      </select>

      <button id="clearSearch" class="px-4 py-2 bg-gray-300 text-gray-800 rounded-lg hover:bg-gray-400 transition-all duration-300 w-full sm:w-auto" onclick="clearSearch()">Clear</button>
    </div>
  </form>
</header>

                   
                    <!-- Order Listing as Table -->
                    <div id="order" class="space-y-6">
                        <% if (!orders || orders.length === 0) { %>
                            <p class="text-center text-gray-600">No orders found.</p>
                        <% } else { %>
                            <div class="overflow-x-auto">
                                <table class="order-table">
                                    <thead>
                                        <tr class="bg-gray-100 text-gray-900">
                                            <th class="px-6 py-4 font-bold">Order ID</th>
                                            <th class="px-6 py-4 font-bold">Date</th>
                                            <th class="px-6 py-4 font-bold">User</th>
                                            <th class="px-6 py-4 font-bold">Items</th>
                                            <th class="px-6 py-4 font-bold">Status</th>
                                            <th class="px-6 py-4 font-bold">Total</th>
                                            <th class="px-6 py-4 font-bold">Details</th>
                                            <th class="px-6 py-4 font-bold">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% orders.forEach(order => { %>
                                            <tr class="table-row bg-gray-50 border-b border-gray-200 hover:bg-gray-100" data-order-id="<%= order.orderID %>">
                                                <td class="px-6 py-4"><%= order.orderID %></td>
                                                <td class="px-6 py-4"><%= new Date(order.createdAt).toLocaleDateString() %></td>
                                                <td class="px-6 py-4"><%= order.user ? order.user.name : 'Unknown' %></td>
                                                <td class="px-4 py-4"><%= order.items ? order.items.length : 0 %></td>
                                                <td class="px-8 py-1 status-cell">
                                                    <span class="status-btn rounded-lg py-1 px-1 <%= order.orderStatus === 'Delivered' ? 'bg-green-300 text-green-800' : order.orderStatus === 'Processing' ? 'bg-yellow-200 text-yellow-800' : order.orderStatus === 'Shipped' ? 'bg-blue-200 text-blue-800' : order.orderStatus === 'Out for Delivery' ? 'bg-indigo-200 text-indigo-800' : order.orderStatus === 'Cancelled' ? 'bg-red-200 text-red-800' : order.orderStatus === 'ReturnRequest' ? 'bg-orange-200 text-orange-800' : 'bg-gray-200 text-gray-800' %>">
                                                        <%= order.orderStatus %>
                                                    </span><br>
                                                    <% if(order.orderStatus !=='ReturnRequest' && order.orderStatus !=='Returned' && order.returnRequestCount > 0) { %>
                                                        <span class="status-btn rounded-lg py-1 px-2 bg-violet-300 text-violet-800 ">
                                                            RtnReq <%= order.returnRequestCount %>
                                                        </span>
                                                    <% } %>
                                                </td>
                                                <td class="px-6 py-4">₹<%= order.finalAmount %></td>
                                                <td class="px-6 py-4">
                                                    <a href="/admin/order/details/<%= order.orderID %>" 
                                                       class="btn-block px-4 py-2 bg-gradient-to-r from-amber-500 to-orange-500 text-white rounded-lg hover:from-amber-600 hover:to-orange-600 transition-all duration-300 block text-center w-full sm:w-auto">
                                                        View
                                                    </a>
                                                </td>
                                                <td class=" py-4 actions-cell">
                                                    <% if (!['Cancelled', 'Returned', 'Delivered','ReturnRequest','Return Rejected','Pending'].includes(order.orderStatus)) { %>
                                                        <select name="status" 
                                                                onchange="updateStatus('<%= order.orderID %>', this.value)" 
                                                                class="border border-gray-200 rounded-lg py-2  focus:outline-none focus:ring-2 focus:ring-amber-500 w-full sm:w-auto mb-2">
                                                            <option value="" disabled>Select Status</option>
                                                            <% if (order.orderStatus === 'Processing') { %>
                                                                <option value="Shipped">Shipped</option>
                                                                <option value="Cancelled">Cancelled</option>
                                                            <% } else if (order.orderStatus === 'Shipped') { %>
                                                                <option value="Out for Delivery">Out for Delivery</option>
                                                                <option value="Cancelled">Cancelled</option>
                                                            <% } else if (order.orderStatus === 'Out for Delivery') { %>
                                                                <option value="Delivered">Delivered</option>
                                                                <option value="Cancelled">Cancelled</option>
                                                            <% } %>
                                                            <option value="<%= order.orderStatus %>" selected hidden><%= order.orderStatus %></option>
                                                        </select>
                                                    <% } %>
                                                    <% if (order.orderStatus === 'ReturnRequest') { %>
                                                        <button 
                                                            onclick="showReturnModal('<%= order.orderID %>', <%= order.finalAmount %>, <%= JSON.stringify(order.returnReason || 'No reason provided') %>)" 
                                                            class="btn-block px-4 py-2 bg-gradient-to-r from-amber-500 to-orange-500 text-white rounded-lg hover:from-amber-600 hover:to-orange-600 transition-all duration-300 w-full sm:w-auto block text-center">
                                                            Verify Return
                                                        </button>
                                                    <% } %>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } %>
                    </div>

                    <!-- Pagination -->
                    <div class="pagination-container mt-8 flex justify-center items-center gap-2">
                        <% if (currentPage > 1) { %>
                            <a href="/admin/order?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(search || '') %>&sort=<%= sort %>&filter=<%= encodeURIComponent(filter || '') %>" 
                               class="btn-block bg-gray-50 text-amber-600 border-amber-500 hover:bg-amber-500 hover:text-white hover:border-amber-600 px-4 py-2 rounded-lg transition-all duration-300">
                                « Previous
                            </a>
                        <% } %>
                        <% for (let i = 1; i <= totalPages; i++) { %>
                            <% if (i === currentPage) { %>
                                <span class="current-page bg-amber-500 text-white border-amber-500 px-4 py-2 rounded-lg font-bold"><%= i %></span>
                            <% } else { %>
                                <a href="/admin/order?page=<%= i %>&search=<%= encodeURIComponent(search || '') %>&sort=<%= sort %>&filter=<%= encodeURIComponent(filter || '') %>" 
                                   class="btn-block bg-gray-50 text-amber-600 border-amber-500 hover:bg-amber-500 hover:text-white hover:border-amber-600 px-4 py-2 rounded-lg transition-all duration-300">
                                    <%= i %>
                                </a>
                            <% } %>
                        <% } %>
                        <% if (currentPage < totalPages) { %>
                            <a href="/admin/order?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(search || '') %>&sort=<%= sort %>&filter=<%= encodeURIComponent(filter || '') %>" 
                               class="btn-block bg-gray-50 text-amber-600 border-amber-500 hover:bg-amber-500 hover:text-white hover:border-amber-600 px-4 py-2 rounded-lg transition-all duration-300">
                                Next »
                            </a>
                        <% } %>
                    </div>

                    <!-- Return Verification Modal -->
                    <div id="returnModal" class="modal">
                        <div class="modal-content">
                            <h3 class="text-lg font-bold mb-4">Verify Return for Order <span id="modalOrderID"></span></h3>
                            <p class="mb-4">Final Amount: ₹<span id="modalFinalAmount"></span></p>
                            <p class="mb-4">Return Reason: <span id="modalReturnReason"></span></p>
                            <p class="mb-4">Please select an action for this return request:</p>
                            <div class="flex justify-end gap-2">
                                <button onclick="verifyReturn('allow')" 
                                        class="btn-block px-4 py-2 bg-gradient-to-r from-amber-500 to-orange-500 text-white rounded-lg hover:from-amber-600 hover:to-orange-600 transition-all duration-300">
                                    Allow
                                </button>
                                <button onclick="verifyReturn('reject')" 
                                        class="btn-block px-4 py-2 bg-gradient-to-r from-amber-500 to-orange-500 text-white rounded-lg hover:from-amber-600 hover:to-orange-600 transition-all duration-300">
                                    Reject
                                </button>
                                <button onclick="closeReturnModal()" 
                                        class="btn-block px-4 py-2 bg-gray-300 text-gray-800 rounded-lg hover:bg-gray-400 transition-all duration-300">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include("../partials/admin/footer") %>

    <script>
        let currentOrderID = null;

        function validateSearch(input) {
            const searchError = document.getElementById('searchError');
            if (input.value.length > 50) {
                searchError.textContent = 'Search term cannot exceed 50 characters.';
                input.value = input.value.slice(0, 50);
            } else if (!/^[a-zA-Z0-9-]*$/.test(input.value)) {
                searchError.textContent = 'Only letters, numbers, and hyphens are allowed.';
            } else {
                searchError.textContent = '';
            }
        }

        function updateStatus(orderID, status) {
            if (!status || status === 'Returned') {
                Swal.fire('Please select a valid status.');
                return;
            }
            fetch(`/admin/order/status/update/${orderID}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    
                    const row = document.querySelector(`tr[data-order-id="${orderID}"]`);
                    if (!row) {
                        Swal.fire('Error: Order row not found.');
                        return;
                    }

                   
                    const statusCell = row.querySelector('.status-cell');
                    const statusClasses = {
                        'Delivered': 'bg-green-200 text-green-800',
                        'Processing': 'bg-yellow-200 text-yellow-800',
                        'Shipped': 'bg-blue-200 text-blue-800',
                        'Out for Delivery': 'bg-indigo-200 text-indigo-800',
                        'Cancelled': 'bg-red-200 text-red-800',
                        'ReturnRequest': 'bg-orange-200 text-orange-800',
                        'Returned': 'bg-gray-200 text-gray-800'
                    };
                    statusCell.innerHTML = `<span class="status-btn ${statusClasses[status] || 'bg-gray-200 text-gray-800'}">${status}</span>`;

                    // Update actions cell
                    const actionsCell = row.querySelector('.actions-cell');
                    let newActions = '';
                    if (!['Cancelled', 'Returned', 'Delivered', 'ReturnRequest'].includes(status)) {
                        const statusOptions = {
                            'Processing': ['Shipped', 'Cancelled'],
                            'Shipped': ['Out for Delivery', 'Cancelled'],
                            'Out for Delivery': ['Delivered', 'Cancelled']
                        };
                        const options = statusOptions[status] || [];
                        newActions = `
                            <select name="status" 
                                    onchange="updateStatus('${orderID}', this.value)" 
                                    class="border border-gray-200 rounded-lg py-2 px-1 focus:outline-none focus:ring-2 focus:ring-amber-500 w-full sm:w-auto mb-2">
                                <option value="" disabled>Select Status</option>
                                ${options.map(opt => `<option value="${opt}">${opt}</option>`).join('')}
                                <option value="${status}" selected hidden>${status}</option>
                            </select>
                        `;
                    }
                    actionsCell.innerHTML = newActions;

                    Swal.fire({
  icon: 'success',
  title: 'Status Updated!',
  text: 'The status has been updated successfully.',
  showConfirmButton: false,
  timer: 1000
});

                } else {
                    Swal.fire({
                        icon:'error',
                        title:'Error in updating',
                        text:'status updating error',
                        showConfirmButton:true,
                        timer:1000
                    });
                }
            })
            .catch(error => Swal.fire('Network error. Please try again.'));
        }

        function showReturnModal(orderID, finalAmount, returnReason) {
            currentOrderID = orderID;
            document.getElementById('modalOrderID').textContent = orderID;
            document.getElementById('modalFinalAmount').textContent = finalAmount;
            document.getElementById('modalReturnReason').textContent = returnReason;
            document.getElementById('returnModal').style.display = 'block';
        }

        function closeReturnModal() {
            document.getElementById('returnModal').style.display = 'none';
            currentOrderID = null;
        }

        function verifyReturn(action) {
            if (!currentOrderID) {
                Swal.fire('No order selected.');
                return;
            }
            let endpoint = '';
            let message = '';
            if (action === 'allow') {
                endpoint = `/admin/order/return/verify/${currentOrderID}`;
                message = 'Return verified and amount refunded to wallet.';
            } else if (action === 'reject') {
                endpoint = `/admin/order/return/reject/${currentOrderID}`;
                message = 'Return request rejected.';
            }
            fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    Swal.fire(message);
                    closeReturnModal();
                    location.reload(); 
                } else {
                    Swal.fire(data.message || `Error ${action}ing return.`);
                }
            })
            .catch(error => Swal.fire('Network error. Please try again.'));
        }

        function searchOrders() {
            const searchTerm = document.getElementById('searchOrder').value.trim();
            const sortOrder = document.getElementById('sortOrder').value;
            const filterStatus = document.getElementById('filterStatus').value;
            if (searchTerm && !/^[a-zA-Z0-9-]*$/.test(searchTerm)) {
                Swal.fire('Search term must contain only letters, numbers, and hyphens.');
                return;
            }
            window.location.href = `/admin/order?search=${encodeURIComponent(searchTerm)}&sort=${sortOrder}&filter=${encodeURIComponent(filterStatus)}&page=1&t=${Date.now()}`;
        }

        document.getElementById('clearSearch').addEventListener('click', () => {
            document.getElementById('searchOrder').value = '';
            document.getElementById('sortOrder').value = 'desc';
            document.getElementById('filterStatus').value = '';
            window.location.href = `/admin/order?page=1&t=${Date.now()}`;
        });
    </script>

    <%- include("../partials/admin/footer") %>
</body>
</html>